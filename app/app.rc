#include <windows.h>
#include <commctrl.h>
#include "resource.h"

IDI_CAMFX ICON "camfx.ico"
1 RT_MANIFEST "app.manifest"

#define TB(id, x, y, w) CONTROL "", id, TRACKBAR_CLASS, TBS_HORZ | TBS_NOTICKS | TBS_TOOLTIPS | WS_TABSTOP, x, y, w, 14

IDD_MAIN DIALOGEX 0, 0, 520, 350
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "CamFX"
FONT 9, "Segoe UI Variable Text", 400, 0, 0x1
BEGIN
    LTEXT           "CAMERA & PREVIEW", IDC_CAMERA_SECTION, 12, 12, 180, 11
    LTEXT           "Camera", -1, 12, 31, 42, 10
    COMBOBOX        IDC_CAMERA, 12, 42, 254, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "", IDC_PREVIEW, "Static", SS_OWNERDRAW, 12, 69, 254, 143
    AUTOCHECKBOX    "Preview", IDC_PREVIEW_ON, 12, 220, 55, 12
    LTEXT           "", IDC_STATUS, 74, 221, 192, 12

    LTEXT           "FRAMING", IDC_FRAME_SECTION, 12, 246, 120, 11
    LTEXT           "Zoom", -1, 12, 265, 40, 10
    TB(IDC_ZOOM, 57, 263, 209)
    LTEXT           "Pan X", -1, 12, 285, 40, 10
    TB(IDC_PANX, 57, 283, 209)
    LTEXT           "Pan Y", -1, 12, 305, 40, 10
    TB(IDC_PANY, 57, 303, 209)
    AUTOCHECKBOX    "Auto-frame (follow me)", IDC_AUTOFRAME, 12, 326, 118, 12
    AUTOCHECKBOX    "Mirror", IDC_MIRROR, 150, 326, 60, 12

    LTEXT           "BACKGROUND & LOOK", IDC_LOOK_SECTION, 286, 12, 180, 11
    LTEXT           "Background", -1, 286, 31, 58, 10
    COMBOBOX        IDC_BG, 354, 28, 154, 80, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "Blur", -1, 286, 54, 58, 10
    TB(IDC_BLUR, 350, 52, 158)
    PUSHBUTTON      "Choose image...", IDC_BGIMAGE, 354, 72, 154, 16
    LTEXT           "Filter", -1, 286, 105, 58, 10
    COMBOBOX        IDC_FILTER, 354, 102, 154, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Brightness", -1, 286, 130, 58, 10
    TB(IDC_BRIGHTNESS, 350, 128, 158)
    LTEXT           "Contrast", -1, 286, 150, 58, 10
    TB(IDC_CONTRAST, 350, 148, 158)
    LTEXT           "Saturation", -1, 286, 170, 58, 10
    TB(IDC_SATURATION, 350, 168, 158)
    LTEXT           "Warmth", -1, 286, 190, 58, 10
    TB(IDC_WARMTH, 350, 188, 158)
    LTEXT           "Exposure", -1, 286, 210, 58, 10
    TB(IDC_EXPOSURE, 350, 208, 158)
    AUTOCHECKBOX    "Low-light boost", IDC_LOWLIGHT, 354, 232, 105, 12
    PUSHBUTTON      "Reset adjustments", IDC_RESET, 354, 251, 100, 16

    LTEXT           "SYSTEM", IDC_SYSTEM_SECTION, 286, 283, 120, 11
    AUTOCHECKBOX    "Start with Windows", IDC_AUTOSTART, 286, 302, 105, 12
    AUTOCHECKBOX    "Show panel when a call starts", IDC_POPUP, 286, 320, 150, 12
    LTEXT           "Choose CamFX Camera in your call app.", IDC_CALL_HELP, 286, 338, 220, 10
END
